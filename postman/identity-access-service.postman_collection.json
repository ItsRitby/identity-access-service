    {
      "name": "US-2: Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();\r\nif (res.token) {\r\n  pm.environment.set(\"token\", res.token);\r\n  console.log(\"Token saved:\", res.token.slice(0, 30) + \"...\");\r\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"playerone\",\r\n  \"password\": \"secret123\"\r\n}",
