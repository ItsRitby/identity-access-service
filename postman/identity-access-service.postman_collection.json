    {
      "name": "US-1: Register User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();\r\nif (res.recoveryCode) {\r\n  pm.environment.set(\"recoveryCode\", res.recoveryCode);\r\n  console.log(\"Recovery code saved:\", res.recoveryCode);\r\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"playerone\",\r\n    \"nickname\": \"TheChosen\",\r\n    \"password\": \"secret123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "users"
          ]
        }
      },
      "response": []
